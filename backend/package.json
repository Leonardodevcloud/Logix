{
  "name": "logix-backend",
  "version": "1.0.0",
  "description": "API multiempresa de gestão de entregas — Logix — Inteligência em cada rota",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke-test.js",
    "backfill:km": "node scripts/backfill-km.js",
    "backfill:lojas": "node scripts/backfill-lojas.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deps:check": "depcruise src server.js worker.js --config .dependency-cruiser.cjs --ignore-known",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run deps:check && npm test",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "deps:baseline": "depcruise src server.js worker.js --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "deps:divida": "depcruise src server.js worker.js --config .dependency-cruiser.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@sentry/node": "^10.73.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "dependency-cruiser": "^16.4.1",
    "eslint": "^9.11.0",
    "globals": "^15.9.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
