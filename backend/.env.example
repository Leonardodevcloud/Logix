# Servidor
PORT=3000
NODE_ENV=production
# OBRIGATÓRIO em produção: lista explícita. Sem isto o painel web NÃO consegue chamar a API
# (a API nunca reflete origem desconhecida — ADR-005).
CORS_ORIGIN=https://app.logix.com.br,https://portal.logix.com.br

# Observabilidade
LOG_LEVEL=info                 # trace|debug|info|warn|error
SENTRY_DSN=                    # vazio = Sentry desligado
METRICS_TOKEN=                 # Bearer exigido em GET /metrics (Prometheus). Vazio = /metrics desligado (404)
APP_VERSION=                   # opcional; aparece em /health e nos logs (ex.: sha do commit)

# Banco PostgreSQL (Railway, Supabase, VPS... — qualquer DATABASE_URL Postgres)
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# SSL: managed/proxy público = true (padrão). Postgres INTERNO do Railway (rede privada) = false
DB_SSL=true
# Validação do certificado (padrão: true). Só false para proxy público do Railway com cert autoassinado.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5   # enxuto p/ instância pequena. Com N réplicas: soma tem que caber no limite do Postgres.
DB_STATEMENT_TIMEOUT_MS=20000

# JWT dual-token
JWT_ACCESS_SECRET=troque-por-um-segredo-forte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DIAS=7

# Integrações
ORS_API_KEY=sua-chave-openrouteservice
DOMINIO_BASE=logix.com.br

# Redis (opcional, OBRIGATÓRIO para 2+ réplicas da API): pub/sub do WebSocket entre
# réplicas, rate-limit compartilhado, cache ORS/Google. Sem ele: modo 1 réplica.
# Railway: + New → Database → Redis → use ${{Redis.REDIS_URL}} (rede privada).
REDIS_URL=

# Cron: todo job roda com advisory lock do Postgres, então é SEGURO deixar embutido
# mesmo com N réplicas (só uma executa). Suba o worker separado (npm run worker) quando
# quiser tirar carga da API; aí defina WORKER_EMBUTIDO=false nas réplicas da API.
WORKER_EMBUTIDO=true
# Retenção de rastreamento (dias) — menor = menos volume de banco = mais barato
RASTREAMENTO_RETENCAO_DIAS=30

# Seed do super_admin (npm run seed)
SEED_ADMIN_NOME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=

# Smoke-test (npm run smoke)
BASE_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_SENHA=
